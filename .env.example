# Copy to .env.local and fill in. This template is safe to commit.

# Paste your Gemini key from aistudio.google.com after the = (no quotes, no spaces)
GOOGLE_GENERATIVE_AI_API_KEY=

# Models (free tier). Change here to swap models later.
PLANNER_MODEL=gemini-3.8-flash
# Tried in order when the planner model is busy (free tier returns 503 at peak times)
FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
FAST_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2
